---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {i < items.length - 1 && <span class="breadcrumb__sep" aria-hidden="true">›</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--green-600);
    text-decoration: underline;
  }
  .breadcrumb span[aria-current='page'] {
    color: var(--green-900);
    font-weight: 600;
  }
  .breadcrumb__sep {
    color: var(--text-soft);
  }
</style>
