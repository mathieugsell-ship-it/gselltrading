---
import Icon from './Icon.astro';
---

<a class="floating-cta" href="/contact" data-floating aria-label="Nous contacter">
  <Icon name="mail" size={20} />
  <span>Contact</span>
</a>

<style>
  .floating-cta {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.15rem;
    background: var(--mint);
    color: var(--green-900);
    font-weight: 700;
    border-radius: 999px;
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .floating-cta.is-visible {
    opacity: 1;
    transform: none;
  }
  .floating-cta:hover {
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .floating-cta {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta {
      transition: none;
    }
  }
</style>
