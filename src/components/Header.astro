---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, REPORTS } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '') || '/';
  if (clean === '/') return current === '/';
  return current === clean || current.startsWith(clean + '/');
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo light />

    <button
      class="burger"
      data-burger
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="primary-nav" data-nav aria-label="Navigation principale">
      <ul class="site-nav__list">
        {
          NAV.map((item) =>
            item.label === 'Rapports' ? (
              <li class="has-mega" data-mega>
                <button
                  class="site-nav__link mega-trigger"
                  data-mega-trigger
                  aria-expanded="false"
                  aria-controls="mega-rapports"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <svg class="mega-caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="mega" id="mega-rapports" data-mega-panel>
                  <div class="mega__inner">
                    <a class="mega__intro" href="/rapports">
                      <span class="mega__eyebrow">Rapports de marché</span>
                      <span class="mega__introtitle">Notre lecture des filières agro thaïes</span>
                      <span class="mega__introlink">
                        Voir tous les rapports
                        <Icon name="arrow-right" size={16} />
                      </span>
                    </a>
                    <div class="mega__grid">
                      {REPORTS.map((r) => (
                        <a class="mega__card" href={`/rapports/${r.slug}`}>
                          <span class="mega__icon"><Icon name={r.icon} size={20} /></span>
                          <span class="mega__text">
                            <span class="mega__title">{r.shortTitle}</span>
                            <span class="mega__desc">{r.menuDesc}</span>
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  class="site-nav__link"
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <a class="btn btn--primary site-nav__cta" href="/contact">
        Discuter de votre projet
        <Icon name="arrow-right" size={18} />
      </a>
    </nav>
  </div>
</header>

<script>
  // Mega-menu: hover/focus handled in CSS; click + keyboard here for touch & a11y.
  const mega = document.querySelector<HTMLElement>('[data-mega]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-mega-trigger]');
  const isDesktop = () => window.matchMedia('(min-width: 861px)').matches;

  const closeMega = () => {
    mega?.classList.remove('is-open');
    trigger?.setAttribute('aria-expanded', 'false');
  };
  trigger?.addEventListener('click', (e) => {
    e.preventDefault();
    const open = mega?.classList.toggle('is-open');
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', (e) => {
    if (mega && !mega.contains(e.target as Node)) closeMega();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMega();
  });
  // Reset the open state when crossing the mobile/desktop boundary.
  window.addEventListener('resize', () => {
    if (isDesktop()) closeMega();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-petrol-900) 86%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: background 0.25s var(--ease), box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .site-header.is-scrolled {
    background: var(--color-petrol-900);
    border-bottom-color: color-mix(in srgb, var(--color-petrol-300) 30%, transparent);
    box-shadow: var(--shadow-md);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 1rem;
    transition: min-height 0.25s var(--ease);
  }
  .site-header.is-scrolled .site-header__inner {
    min-height: 60px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-inverse);
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--mint);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav__link:hover {
    color: var(--accent-hover);
  }
  .site-nav__link[aria-current='page'] {
    color: var(--accent-hover);
  }
  .mega-caret {
    transition: transform 0.2s var(--ease);
  }

  /* ---- Mega-menu (desktop) ---- */
  .has-mega {
    position: static;
  }
  .mega {
    position: absolute;
    left: 50%;
    top: calc(100% - 4px);
    transform: translateX(-50%) translateY(8px);
    width: min(720px, calc(100vw - 2rem));
    background: var(--color-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease),
      visibility 0.2s;
    z-index: 120;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega,
  .has-mega.is-open .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .has-mega:hover .mega-caret,
  .has-mega.is-open .mega-caret {
    transform: rotate(180deg);
  }
  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 1.25rem;
  }
  .mega__intro {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: linear-gradient(150deg, var(--color-petrol-900), var(--color-petrol-600));
    color: var(--color-white);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    text-decoration: none;
  }
  .mega__intro:hover {
    text-decoration: none;
  }
  .mega__eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mint);
    font-weight: 700;
  }
  .mega__introtitle {
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .mega__introlink {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--mint);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .mega__grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .mega__card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.15s var(--ease);
  }
  .mega__card:hover {
    background: var(--bg-pale);
    text-decoration: none;
  }
  .mega__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--bg-pale);
    color: var(--green-600);
  }
  .mega__card:hover .mega__icon {
    background: var(--color-white);
  }
  .mega__text {
    display: flex;
    flex-direction: column;
  }
  .mega__title {
    font-weight: 700;
    color: var(--green-900);
  }
  .mega__desc {
    font-size: 0.85rem;
    color: var(--text-soft);
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 110;
  }
  .burger span {
    display: block;
    height: 2.5px;
    width: 100%;
    background: var(--text-inverse);
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }

  @media (max-width: 860px) {
    .burger {
      display: flex;
    }
    .site-nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(82vw, 340px);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.25rem;
      padding: 5.5rem 1.5rem 2rem;
      background: var(--color-petrol-900);
      box-shadow: var(--shadow-lg);
      transform: translateX(105%);
      transition: transform 0.3s var(--ease);
      overflow-y: auto;
    }
    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .site-nav__link {
      display: flex;
      justify-content: space-between;
      padding: 0.85rem 0;
      border-bottom: 1px solid color-mix(in srgb, var(--color-petrol-300) 20%, transparent);
      font-size: 1.05rem;
      width: 100%;
    }
    .site-nav__link::after {
      display: none;
    }
    /* Mobile: mega becomes an inline accordion */
    .has-mega {
      position: relative;
    }
    .mega {
      position: static;
      transform: none;
      width: 100%;
      box-shadow: none;
      border: none;
      padding: 0.5rem 0 0.75rem;
      max-height: 0;
      overflow: hidden;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: max-height 0.3s var(--ease);
    }
    .has-mega:hover .mega,
    .has-mega:focus-within .mega {
      transform: none;
    }
    .has-mega.is-open .mega {
      max-height: 520px;
    }
    .mega__inner {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .mega__intro {
      padding: 0.9rem;
    }
    /* Inline accordion sits on the dark petrol panel → light text */
    .mega__title {
      color: var(--text-inverse);
    }
    .mega__desc {
      color: var(--color-petrol-300);
    }
    .mega__icon {
      background: color-mix(in srgb, var(--color-petrol-300) 18%, transparent);
      color: var(--color-petrol-300);
    }
    .mega__card:hover {
      background: color-mix(in srgb, var(--color-petrol-300) 12%, transparent);
    }
    .mega__card:hover .mega__icon {
      background: color-mix(in srgb, var(--color-petrol-300) 24%, transparent);
    }
    .site-nav__cta {
      margin-top: 1rem;
      justify-content: center;
    }
    :global(.is-menu-open) .site-nav {
      transform: translateX(0);
    }
    :global(.is-menu-open) .burger span:nth-child(1) {
      transform: translateY(7.5px) rotate(45deg);
    }
    :global(.is-menu-open) .burger span:nth-child(2) {
      opacity: 0;
    }
    :global(.is-menu-open) .burger span:nth-child(3) {
      transform: translateY(-7.5px) rotate(-45deg);
    }
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega {
      transition: none;
    }
  }
</style>
