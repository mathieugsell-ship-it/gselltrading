---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '') || '/';
  if (clean === '/') return current === '/';
  return current === clean || current.startsWith(clean + '/');
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo />

    <button
      class="burger"
      data-burger
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="primary-nav" data-nav aria-label="Navigation principale">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary site-nav__cta" href="/contact">
        Discuter de votre projet
        <Icon name="arrow-right" size={18} />
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: background 0.25s var(--ease), box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.96);
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 1rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    color: var(--green-900);
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
  }
  .site-nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--mint);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease);
  }
  .site-nav ul a:hover::after,
  .site-nav ul a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav ul a[aria-current='page'] {
    color: var(--green-600);
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 110;
  }
  .burger span {
    display: block;
    height: 2.5px;
    width: 100%;
    background: var(--green-900);
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }

  @media (max-width: 860px) {
    .burger {
      display: flex;
    }
    .site-nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(78vw, 320px);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.25rem;
      padding: 5.5rem 1.75rem 2rem;
      background: #fff;
      box-shadow: var(--shadow-lg);
      transform: translateX(105%);
      transition: transform 0.3s var(--ease);
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .site-nav ul a {
      display: block;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 1.05rem;
    }
    .site-nav ul a::after {
      display: none;
    }
    .site-nav__cta {
      margin-top: 1rem;
      justify-content: center;
    }
    :global(.is-menu-open) .site-nav {
      transform: translateX(0);
    }
    :global(.is-menu-open) .burger span:nth-child(1) {
      transform: translateY(7.5px) rotate(45deg);
    }
    :global(.is-menu-open) .burger span:nth-child(2) {
      opacity: 0;
    }
    :global(.is-menu-open) .burger span:nth-child(3) {
      transform: translateY(-7.5px) rotate(-45deg);
    }
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }
</style>
