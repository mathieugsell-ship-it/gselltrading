---
import Icon from './Icon.astro';
import HeroProductField from './HeroProductField.astro';

const bullets = [
  'Spécialistes agro-alimentaire',
  'Sur le terrain à Phuket',
  'Commission transparente',
];
---

<section class="hero" data-hero>
  <div class="hero__field"><HeroProductField /></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__kicker">Sourcing agro-alimentaire · Thaïlande</span>
      <h1 class="hero__title">
        Importer des produits agro-alimentaires thaïlandais,
        <span class="hero__accent">en toute confiance.</span>
      </h1>
      <p class="hero__subtitle">
        Basés en Thaïlande, nous accompagnons les sociétés étrangères qui
        sourcent du riz, du thon en conserve et des produits agro-alimentaires
        thaïs — du fournisseur au conteneur expédié. Sans stock, à commission
        transparente.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/contact">
          Discuter de votre projet
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--outline" href="/rapports">Consulter nos rapports</a>
      </div>
      <ul class="hero__bullets">
        {
          bullets.map((b) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {b}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(120% 120% at 15% 12%, #fbf9f4 0%, #f6f1e7 58%, #f1ead9 100%);
  }
  /* subtle warm + faint mint corner veils */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(38% 44% at 92% 8%, rgba(229, 162, 75, 0.16), transparent 70%),
      radial-gradient(36% 42% at 6% 96%, rgba(127, 217, 168, 0.14), transparent 70%);
    pointer-events: none;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(3rem, 7vw, 5rem);
    pointer-events: none;
  }
  .hero__content {
    max-width: 620px;
  }
  .hero__content :where(a, .btn) {
    pointer-events: auto;
  }

  .hero__kicker {
    display: inline-flex;
    flex-direction: column;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #1a5c42;
    margin-bottom: 1.1rem;
  }
  .hero__kicker::after {
    content: '';
    width: 46px;
    height: 3px;
    border-radius: 2px;
    background: #e5a24b;
    margin-top: 0.55rem;
  }
  .hero__title {
    color: #0f3d2e;
    font-size: clamp(1.9rem, 3.2vw, 2.95rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.022em;
    max-width: 640px;
    text-wrap: balance;
    margin: 0 0 1.15rem;
  }
  .hero__accent {
    color: #237a53;
  }
  .hero__subtitle {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.55;
    color: #46574c;
    max-width: 500px;
    margin: 0 0 1.7rem;
  }
  .hero__cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .hero__cta .btn {
    padding-block: 0.72rem;
  }
  .hero__bullets {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.35rem;
  }
  .hero__bullets li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: #23402f;
  }
  .hero__bullets svg {
    color: #237a53;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding-bottom: clamp(1.5rem, 5vw, 2.5rem);
    }
    .hero__field {
      position: static;
      order: 2;
      z-index: 2;
      padding-inline: var(--gutter);
    }
    .hero__inner {
      order: 1;
      pointer-events: auto;
      padding-bottom: 0.5rem;
    }
    .hero__content {
      max-width: 640px;
    }
  }
</style>
