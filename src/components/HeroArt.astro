---
// Flat, on-brand agro-food illustration for the hero (no stock photography).
// Reads on the dark green hero gradient: light fills + mint accents.
---

<svg
  class="hero-art"
  viewBox="0 0 520 460"
  role="img"
  aria-label="Illustration : conteneur d'export, sacs de riz et conserve de thon thaïlandais"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="ha-can" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a9e6c4" />
      <stop offset="1" stop-color="#7fd9a8" />
    </linearGradient>
  </defs>

  <!-- soft blobs -->
  <circle cx="410" cy="110" r="86" fill="#ffffff" opacity="0.06" />
  <circle cx="120" cy="360" r="60" fill="#ffffff" opacity="0.05" />

  <!-- dashed export route + plane/ship arc -->
  <path d="M60,150 C180,60 360,60 470,140" fill="none" stroke="#7fd9a8" stroke-width="2.5" stroke-dasharray="4 9" stroke-linecap="round" opacity="0.7" />
  <circle cx="60" cy="150" r="5" fill="#7fd9a8" />
  <g transform="translate(470,140)">
    <circle r="7" fill="#7fd9a8" />
    <circle r="12" fill="none" stroke="#7fd9a8" stroke-width="2" opacity="0.5" />
  </g>

  <!-- shipping container -->
  <g>
    <rect x="150" y="205" width="250" height="120" rx="10" fill="#eef7f1" />
    <rect x="150" y="205" width="250" height="120" rx="10" fill="none" stroke="#0b2e22" stroke-width="3" opacity="0.15" />
    <g stroke="#237a53" stroke-width="3" opacity="0.35">
      <line x1="178" y1="215" x2="178" y2="315" />
      <line x1="206" y1="215" x2="206" y2="315" />
      <line x1="234" y1="215" x2="234" y2="315" />
      <line x1="316" y1="215" x2="316" y2="315" />
      <line x1="344" y1="215" x2="344" y2="315" />
      <line x1="372" y1="215" x2="372" y2="315" />
    </g>
    <rect x="262" y="240" width="60" height="50" rx="6" fill="#7fd9a8" />
    <text x="292" y="271" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="20" fill="#0f3d2e">GT</text>
  </g>

  <!-- rice sacks -->
  <g transform="translate(120,300)">
    <path d="M8,28 C2,18 12,4 34,4 C56,4 66,18 60,28 L64,84 C64,92 56,96 34,96 C12,96 4,92 4,84 Z" fill="#ffffff" />
    <path d="M20,4 Q34,-6 48,4 L44,16 Q34,10 24,16 Z" fill="#a9e6c4" />
    <rect x="16" y="48" width="36" height="18" rx="3" fill="#7fd9a8" />
    <circle cx="34" cy="57" r="5" fill="#0f3d2e" />
  </g>
  <g transform="translate(180,330) scale(0.82)">
    <path d="M8,28 C2,18 12,4 34,4 C56,4 66,18 60,28 L64,84 C64,92 56,96 34,96 C12,96 4,92 4,84 Z" fill="#dcefe4" />
    <path d="M20,4 Q34,-6 48,4 L44,16 Q34,10 24,16 Z" fill="#7fd9a8" />
    <rect x="16" y="48" width="36" height="18" rx="3" fill="#237a53" />
  </g>

  <!-- tuna can -->
  <g transform="translate(300,318)">
    <ellipse cx="52" cy="86" rx="52" ry="14" fill="#1a5c42" />
    <rect x="0" y="34" width="104" height="52" fill="url(#ha-can)" />
    <ellipse cx="52" cy="34" rx="52" ry="14" fill="#c8f0da" />
    <ellipse cx="52" cy="34" rx="40" ry="9" fill="#eef7f1" />
    <rect x="14" y="52" width="76" height="20" rx="4" fill="#0f3d2e" opacity="0.85" />
    <text x="52" y="66" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="12" fill="#7fd9a8">THON</text>
  </g>

  <!-- leaf accents -->
  <g transform="translate(392,196)" fill="#7fd9a8">
    <path d="M0,40 C0,14 20,0 44,0 C44,26 26,42 0,40 Z" />
    <path d="M6,36 L38,8" stroke="#0f3d2e" stroke-width="2" opacity="0.3" fill="none" />
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    max-width: 560px;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.22));
  }
</style>
