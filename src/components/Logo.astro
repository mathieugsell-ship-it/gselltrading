---
import { SITE } from '../data/site';
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a class="logo" href="/" aria-label={`${SITE.name} — accueil`}>
  <span class:list={['logo__text', { 'logo__text--light': light }]}>
    {SITE.logoParts.plain}<span class="logo__accent">{SITE.logoParts.accent}</span>
  </span>
</a>

<style>
  .logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .logo__text {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-heading);
    line-height: 1;
  }
  .logo__text--light {
    color: var(--text-inverse);
  }
  /* « TRADING » toujours en ambre (accent chaud), sur fond clair comme sombre */
  .logo__accent,
  .logo__text--light .logo__accent {
    color: var(--accent);
  }
  .logo:hover {
    text-decoration: none;
  }
</style>
