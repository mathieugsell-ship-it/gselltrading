---
import Icon from './Icon.astro';
---

<a class="mobile-cta" href="/contact" aria-label="Nous contacter">
  <Icon name="mail" size={20} />
  <span>Contact</span>
</a>

<style>
  .mobile-cta {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.15rem;
    background: var(--mint);
    color: var(--green-900);
    font-weight: 700;
    border-radius: 999px;
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }
  .mobile-cta:hover {
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .mobile-cta {
      display: inline-flex;
    }
  }
</style>
