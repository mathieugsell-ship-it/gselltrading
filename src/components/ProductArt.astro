---
// Flat, appetising product illustrations in NATURAL colours (no photos).
// The products carry the colour of the hero scene (Directive #2 v2).
interface Props {
  productKey: string;
}
const { productKey } = Astro.props;

const arts: Record<string, string> = {
  // Riz — sac kraft, fenêtre de grains, bandeau vert, grains éparpillés
  riz: `
    <defs><linearGradient id="riz-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efe4c8"/><stop offset="1" stop-color="#e2d3ac"/>
    </linearGradient></defs>
    <path d="M18 27 C15 19 23 13 32 13 C41 13 49 19 46 27 L48 50 C48 56 41 59 32 59 C23 59 16 56 16 50 Z" fill="url(#riz-g)"/>
    <path d="M25 14 Q32 7 39 14 L36 21 Q32 17 28 21 Z" fill="#d8c69a"/>
    <rect x="22" y="30" width="20" height="14" rx="2" fill="#fbf7ec"/>
    <ellipse cx="28" cy="35" rx="3" ry="1.5" fill="#efe1bd" stroke="#d9c79a" stroke-width="0.6"/>
    <ellipse cx="35" cy="34" rx="3" ry="1.5" fill="#efe1bd" stroke="#d9c79a" stroke-width="0.6" transform="rotate(20 35 34)"/>
    <ellipse cx="31" cy="39" rx="3" ry="1.5" fill="#efe1bd" stroke="#d9c79a" stroke-width="0.6" transform="rotate(-15 31 39)"/>
    <rect x="16" y="47" width="32" height="7" fill="#237a53"/>
    <path d="M30 50.5 q2-2.5 4 0 q-2 1-4 0z" fill="#7fd9a8"/>
    <ellipse cx="21" cy="57" rx="3" ry="1.4" fill="#efe1bd" stroke="#d3bf90" stroke-width="0.6"/>
    <ellipse cx="44" cy="57" rx="3" ry="1.4" fill="#efe1bd" stroke="#d3bf90" stroke-width="0.6" transform="rotate(18 44 57)"/>`,
  // Thon — boîte conserve argent, bandeau bleu, point rouge, languette
  thon: `
    <defs><linearGradient id="thon-g" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c6ced4"/><stop offset="0.5" stop-color="#eef2f4"/><stop offset="1" stop-color="#aab4bb"/>
    </linearGradient></defs>
    <rect x="15" y="24" width="34" height="27" rx="2" fill="url(#thon-g)"/>
    <ellipse cx="32" cy="51" rx="17" ry="5" fill="#b4bec4"/>
    <rect x="15" y="33" width="34" height="10" fill="#2f6f9e"/>
    <rect x="15" y="33" width="34" height="2.5" fill="#255c85"/>
    <circle cx="40" cy="38" r="2.6" fill="#d5473b"/>
    <ellipse cx="32" cy="24" rx="17" ry="5" fill="#e7ecef"/>
    <ellipse cx="32" cy="24" rx="11" ry="3" fill="#cdd6db"/>
    <rect x="29" y="22" width="6" height="4" rx="2" fill="#aab4bb"/>`,
  // Noix de coco — demi-coque brune, chair blanche, feuille, éclaboussure lait
  coco: `
    <path d="M13 34 A19 18 0 0 1 51 34 Q51 52 32 55 Q13 52 13 34 Z" fill="#6f4a2f"/>
    <path d="M17 33 A15 14 0 0 1 47 33 Q47 48 32 51 Q17 48 17 33 Z" fill="#8a5f3d"/>
    <ellipse cx="32" cy="31" rx="15" ry="8" fill="#f6efe1"/>
    <ellipse cx="32" cy="31" rx="9" ry="4.5" fill="#ffffff"/>
    <path d="M31 12 Q24 16 21 25 Q29 21 33 14 Q37 21 45 25 Q41 15 33 12 Z" fill="#3a9d63"/>
    <path d="M33 13 Q33 20 32 27" stroke="#2f8a55" stroke-width="1" fill="none"/>
    <circle cx="47" cy="18" r="2.6" fill="#ffffff"/>
    <circle cx="51" cy="24" r="1.8" fill="#ffffff"/>`,
  // Ananas — corps doré, hachures, couronne verte
  fruits: `
    <path d="M32 8 Q27 17 24 23 Q29 21 32 15 Q35 21 40 23 Q37 15 32 8 Z" fill="#3a9d63"/>
    <path d="M20 24 Q26 16 31 22 Q26 26 20 24 Z" fill="#2f8a55"/>
    <path d="M44 24 Q38 16 33 22 Q38 26 44 24 Z" fill="#2f8a55"/>
    <ellipse cx="32" cy="41" rx="15" ry="18" fill="#e8b84b"/>
    <path d="M23 33 L41 49 M41 33 L23 49 M32 28 L32 56 M19 41 L45 41" stroke="#cf9a34" stroke-width="1.4" fill="none"/>
    <ellipse cx="27" cy="36" rx="1.5" ry="1.5" fill="#f2cf76"/>`,
  // Poulet halal — cuisse ambrée, os, pastille halal menthe
  poulet: `
    <path d="M22 20 C13 26 16 40 27 44 C31 46 33 49 35 52 C39 58 50 55 47 46 C52 37 45 24 34 25 C30 20 26 18 22 20 Z" fill="#e6bd8a"/>
    <path d="M22 22 C16 27 18 37 26 41 C24 34 25 28 30 25 C27 22 25 21 22 22 Z" fill="#f0d3ab"/>
    <path d="M40 44 C46 42 50 47 46 51 C50 54 46 60 41 56 C37 59 33 53 38 50 Z" fill="#cf9455"/>
    <circle cx="48" cy="53" r="4.5" fill="#f3ece0"/>
    <circle cx="53" cy="50" r="4.5" fill="#f3ece0"/>
    <circle cx="14" cy="15" r="8" fill="#7fd9a8"/>
    <path d="M10.5 15 l2.5 2.5 L18 12" stroke="#0f3d2e" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  // Pet food — sachet ambre, fenêtre crème, patte verte, croquettes
  petfood: `
    <path d="M20 19 L44 19 L46 54 Q46 58 41 58 L23 58 Q18 58 18 54 Z" fill="#e79a4a"/>
    <path d="M40 19 L46 54 Q46 58 41 58 L37 58 Z" fill="#d1852f"/>
    <path d="M20 19 L32 12 L44 19 Z" fill="#c9822f"/>
    <circle cx="30" cy="40" r="12" fill="#f6efe1"/>
    <circle cx="30" cy="42" r="4" fill="#2f7a5a"/>
    <circle cx="24" cy="36" r="2" fill="#2f7a5a"/>
    <circle cx="30" cy="33.5" r="2" fill="#2f7a5a"/>
    <circle cx="36" cy="36" r="2" fill="#2f7a5a"/>`,
};

const inner = arts[productKey] ?? '';
---

<svg
  class="prod-art"
  viewBox="0 0 64 64"
  role="img"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  set:html={inner}
/>
