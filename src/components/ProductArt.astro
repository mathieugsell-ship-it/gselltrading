---
// Flat, stylised product illustrations (no photos). Parts are class-tagged
// (il-body / il-accent / il-cream / il-leaf / il-line) so HeroProductShowcase
// controls the rest (monochrome) vs. relief (full colour) states via CSS.
interface Props {
  productKey: string;
}
const { productKey } = Astro.props;

const arts: Record<string, string> = {
  // Sac de riz
  riz: `
    <path class="il-body" d="M20 27 C16 19 24 13 32 13 C40 13 48 19 44 27 L47 50 C47 56 40 59 32 59 C24 59 17 56 17 50 Z"/>
    <path class="il-cream" d="M25 14 Q32 7 39 14 L36 21 Q32 17 28 21 Z"/>
    <rect class="il-accent" x="18" y="37" width="28" height="10" rx="2"/>
    <circle class="il-line" cx="27" cy="42" r="1.6"/>
    <circle class="il-line" cx="32" cy="42" r="1.6"/>
    <circle class="il-line" cx="37" cy="42" r="1.6"/>`,
  // Boîte de thon
  thon: `
    <rect class="il-body" x="16" y="23" width="32" height="27" rx="2"/>
    <ellipse class="il-body" cx="32" cy="50" rx="16" ry="5"/>
    <rect class="il-accent" x="16" y="34" width="32" height="9"/>
    <ellipse class="il-cream" cx="32" cy="23" rx="16" ry="5"/>
    <ellipse class="il-accent" cx="32" cy="23" rx="10" ry="3"/>
    <circle class="il-line" cx="32" cy="23" r="2"/>`,
  // Noix de coco (+ éclaboussure)
  coco: `
    <circle class="il-body" cx="31" cy="35" r="18"/>
    <ellipse class="il-cream" cx="31" cy="22" rx="14" ry="6"/>
    <ellipse class="il-accent" cx="31" cy="22" rx="8.5" ry="3.5"/>
    <circle class="il-line" cx="27" cy="35" r="1.6"/>
    <circle class="il-line" cx="35" cy="37" r="1.6"/>
    <circle class="il-line" cx="30" cy="42" r="1.6"/>
    <circle class="il-accent" cx="47" cy="18" r="3"/>
    <circle class="il-accent" cx="51" cy="25" r="2"/>`,
  // Ananas
  fruits: `
    <ellipse class="il-body" cx="32" cy="40" rx="14" ry="18"/>
    <path class="il-leaf" d="M32 6 Q27 16 24 22 Q30 20 32 15 Q34 20 40 22 Q37 16 32 6 Z"/>
    <path class="il-leaf" d="M20 24 Q26 17 31 22 Q26 25 20 24 Z"/>
    <path class="il-leaf" d="M44 24 Q38 17 33 22 Q38 25 44 24 Z"/>
    <path class="il-line" d="M25 34 L39 46 M39 34 L25 46 M32 30 L32 52"/>`,
  // Cuisse de poulet + tag halal
  poulet: `
    <path class="il-body" d="M23 19 C15 25 17 39 27 43 C31 45 33 48 35 51 C39 57 49 55 47 47 C52 39 46 25 35 25 C31 20 27 17 23 19 Z"/>
    <circle class="il-cream" cx="47" cy="52" r="4.5"/>
    <circle class="il-cream" cx="52" cy="49" r="4.5"/>
    <rect class="il-cream" x="42" y="46" width="8" height="9" rx="3" transform="rotate(35 46 50)"/>
    <rect class="il-accent" x="8" y="9" width="17" height="11" rx="3"/>
    <path class="il-line" d="M12 15 l2.5 2.5 L20 12"/>`,
  // Sac de pet food + patte
  petfood: `
    <path class="il-body" d="M20 19 L44 19 L46 53 Q46 58 41 58 L23 58 Q18 58 18 53 Z"/>
    <path class="il-cream" d="M20 19 L32 12 L44 19 Z"/>
    <circle class="il-accent" cx="32" cy="41" r="5"/>
    <circle class="il-accent" cx="25" cy="35" r="2.4"/>
    <circle class="il-accent" cx="31" cy="32" r="2.4"/>
    <circle class="il-accent" cx="37" cy="35" r="2.4"/>`,
};

const inner = arts[productKey] ?? '';
---

<svg
  class="prod-art"
  viewBox="0 0 64 64"
  role="img"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  set:html={inner}
/>
