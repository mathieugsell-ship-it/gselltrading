---
const without = [
  'Fournisseur trouvé en ligne, impossible à vérifier',
  'Barrière de la langue et du fuseau horaire',
  'Risque de fraude au paiement et de société fictive',
  'Qualité jamais contrôlée avant l’expédition',
  'Documents et licences d’export à démêler seul',
  'Aucun recours sur place en cas de problème',
];

const withUs = [
  'Fournisseur vérifié physiquement, sur le terrain',
  'Un interlocuteur unique, bilingue FR / EN',
  'Conditions de paiement sécurisées et protectrices',
  'Contrôle qualité avant empotage du conteneur',
  'Documents et conformité pris en charge pour vous',
  'Une présence à Phuket qui agit en votre nom',
];
---

<div class="ww" data-ww>
  <div class="ww__switch" role="tablist" aria-label="Comparer avec ou sans accompagnement">
    <button role="tab" id="ww-tab-without" aria-selected="false" aria-controls="ww-panel-without" data-ww-btn="without" class="ww__switchbtn">
      Sans accompagnement
    </button>
    <button role="tab" id="ww-tab-with" aria-selected="true" aria-controls="ww-panel-with" data-ww-btn="with" class="ww__switchbtn is-active">
      Avec Gselltrading
    </button>
  </div>

  <div class="ww__cols">
    <div class="ww__col ww__col--without" id="ww-panel-without" role="tabpanel" aria-labelledby="ww-tab-without" data-ww-panel="without">
      <h3 class="ww__coltitle">
        <span class="ww__badge ww__badge--bad" aria-hidden="true">✕</span>
        Sans accompagnement
      </h3>
      <ul class="ww__list">
        {without.map((item) => (
          <li>
            <svg class="ww__mark ww__mark--bad" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="ww__col ww__col--with" id="ww-panel-with" role="tabpanel" aria-labelledby="ww-tab-with" data-ww-panel="with">
      <h3 class="ww__coltitle">
        <span class="ww__badge ww__badge--good" aria-hidden="true">✓</span>
        Avec Gselltrading
      </h3>
      <ul class="ww__list">
        {withUs.map((item) => (
          <li>
            <svg class="ww__mark ww__mark--good" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-ww]');
  if (root) {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-ww-btn]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.wwBtn;
        btns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        root.setAttribute('data-active', key || 'with');
      });
    });
  }
</script>

<style>
  .ww {
    --active: with;
  }
  /* Mobile switch — hidden on desktop where both columns show side by side */
  .ww__switch {
    display: none;
    background: var(--bg-pale);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem;
    margin: 0 auto 1.5rem;
    max-width: 360px;
  }
  .ww__switchbtn {
    flex: 1;
    border: none;
    background: transparent;
    font: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--text-soft);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .ww__switchbtn.is-active {
    background: #fff;
    color: var(--green-900);
    box-shadow: var(--shadow-sm);
  }

  .ww__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .ww__col {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    background: #fff;
  }
  .ww__col--without {
    background: #fdf5f3;
    border-color: #f0d6cf;
  }
  .ww__col--with {
    background: var(--bg-pale);
    border-color: var(--mint);
  }
  .ww__coltitle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    margin-bottom: 1.1rem;
  }
  .ww__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.9rem;
    color: #fff;
    flex-shrink: 0;
  }
  .ww__badge--bad {
    background: #c0553c;
  }
  .ww__badge--good {
    background: var(--green-600);
  }
  .ww__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ww__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    line-height: 1.5;
  }
  .ww__mark {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .ww__mark--bad {
    color: #c0553c;
  }
  .ww__mark--good {
    color: var(--green-600);
  }

  @media (max-width: 720px) {
    .ww__switch {
      display: flex;
    }
    .ww__cols {
      grid-template-columns: 1fr;
    }
    .ww__col {
      display: none;
    }
    .ww[data-active='without'] .ww__col--without,
    .ww[data-active='with'] .ww__col--with,
    .ww:not([data-active]) .ww__col--with {
      display: block;
    }
  }
</style>
