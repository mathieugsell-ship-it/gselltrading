---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';

const title =
  'À propos — Votre courtier agro-alimentaire en Thaïlande | Gselltrading';
const description =
  'Gselltrading accompagne les importateurs de produits agro-alimentaires thaïlandais depuis la Thaïlande. Un modèle sans stock, à commission transparente, un interlocuteur unique.';

const blocks = [
  {
    icon: 'scale',
    title: 'Notre approche',
    text: 'Nous ne détenons pas de stock et ne vous vendons pas notre marchandise : nous trouvons la vôtre. Cette indépendance est au cœur de notre modèle. Nous sommes rémunérés par vous, à la commission transparente, ce qui aligne totalement nos intérêts sur les vôtres — pas de marge cachée, pas de conflit d’intérêt.',
  },
  {
    icon: 'map-pin',
    title: 'Une présence réelle à Phuket',
    text: 'Nous sommes basés en Thaïlande, à Phuket. Cette présence physique nous permet de vérifier, de rencontrer, de négocier et de suivre — là où beaucoup d’intermédiaires opèrent à distance. C’est ce qui fait la différence entre une transaction espérée et une transaction sécurisée.',
  },
  {
    icon: 'sprout',
    title: 'Notre spécialité : l’agro-alimentaire',
    text: 'Nous avons fait le choix de la spécialisation. Plutôt que de tout faire à moitié, nous nous concentrons sur les filières que nous connaissons : riz, thon en conserve, produits halal et agro-transformés. Nos rapports de marché témoignent de cette expertise.',
    link: { href: '/rapports', label: 'Consulter nos rapports' },
  },
  {
    icon: 'languages',
    title: 'Un interlocuteur unique, bilingue',
    text: 'Vous ne parlez qu’à une seule personne, en français ou en anglais, du premier échange jusqu’à la livraison. Pas de service client anonyme : un accompagnement direct et responsable.',
  },
];
---

<BaseLayout title={title} description={description} path="/a-propos">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">À propos</span>
      <h1>Sur le terrain, entre vous et le marché thaï</h1>
      <p class="lead">
        Gselltrading est né d’un constat simple : sourcer en Thaïlande depuis
        l’étranger est risqué quand on n’a personne de fiable sur place. Notre
        métier est de combler ce vide — être vos yeux, vos oreilles et votre
        négociateur sur le terrain, dans l’agro-alimentaire.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container about-list">
      {
        blocks.map((b) => (
          <article class="about-row reveal">
            <div class="about-row__icon">
              <Icon name={b.icon} size={28} />
            </div>
            <div>
              <h2>{b.title}</h2>
              <p>{b.text}</p>
              {b.link && (
                <a class="arrow-link" href={b.link.href}>
                  {b.link.label}
                  <Icon name="arrow-right" size={18} />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="Faisons connaissance."
    text="Un projet, une question, un premier conteneur d’essai : écrivez-nous."
    buttonLabel="Faisons connaissance"
  />
</BaseLayout>

<style>
  .page-hero {
    background: var(--bg-pale-2);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }
  .about-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 900px;
  }
  .about-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .about-row__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: var(--bg-pale);
    color: var(--green-600);
  }
  .about-row h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    margin-bottom: 0.5rem;
  }
  .about-row p {
    margin-bottom: 0.5rem;
  }
  @media (max-width: 560px) {
    .about-row {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
