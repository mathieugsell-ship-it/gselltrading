---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';

const title = 'Contact | Gselltrading';
const description =
  'Contactez Gselltrading pour votre projet d’import de produits agro-alimentaires thaïlandais. Réponse rapide, accompagnement sur mesure depuis la Thaïlande.';

// Web3Forms access key — remplacer par la vraie clé avant lancement.
// Voir https://web3forms.com (compatible sites statiques Cloudflare Pages).
const WEB3FORMS_KEY = '[WEB3FORMS_ACCESS_KEY]';
---

<BaseLayout title={title} description={description} path="/contact">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Parlons de votre projet d’import</h1>
      <p class="lead">
        Décrivez-nous votre besoin — produit recherché, volumes envisagés,
        marché de destination — et nous reviendrons vers vous rapidement pour en
        discuter.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <form
        class="contact-form"
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input
          type="hidden"
          name="subject"
          value="Nouvelle demande — Gselltrading.com"
        />
        <input type="hidden" name="from_name" value="Gselltrading.com" />
        <!-- Honeypot anti-spam -->
        <input
          type="checkbox"
          name="botcheck"
          class="hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="field">
          <label for="name">Nom / société</label>
          <input id="name" name="name" type="text" required autocomplete="organization" />
        </div>

        <div class="field">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="country">Pays</label>
          <input id="country" name="country" type="text" autocomplete="country-name" />
        </div>

        <div class="field">
          <label for="products">Produit(s) recherché(s)</label>
          <input id="products" name="products" type="text" placeholder="Riz, thon en conserve, halal…" />
        </div>

        <div class="field">
          <label for="volumes">Volumes envisagés <span>(optionnel)</span></label>
          <input id="volumes" name="volumes" type="text" placeholder="Ex. 1 conteneur d’essai" />
        </div>

        <div class="field field--full">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <div class="field field--full form-actions">
          <button type="submit" class="btn btn--primary btn--lg">
            Envoyer ma demande
            <Icon name="arrow-right" size={18} />
          </button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="contact-info">
        <h2>Coordonnées directes</h2>
        <ul>
          <li>
            <span class="contact-info__icon"><Icon name="mail" size={20} /></span>
            <div>
              <span class="contact-info__label">E-mail</span>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </div>
          </li>
          <li>
            <span class="contact-info__icon"><Icon name="phone" size={20} /></span>
            <div>
              <span class="contact-info__label">WhatsApp / Téléphone</span>
              <a href={`https://wa.me/${SITE.phone.replace(/[^0-9]/g, '')}`}>{SITE.phone}</a>
            </div>
          </li>
          <li>
            <span class="contact-info__icon"><Icon name="map-pin" size={20} /></span>
            <div>
              <span class="contact-info__label">Localisation</span>
              <span>{SITE.address.display}</span>
            </div>
          </li>
        </ul>
        <p class="contact-info__note">
          Un interlocuteur unique, en français ou en anglais, du premier échange
          à la livraison.
        </p>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      if (!status) return;
      e.preventDefault();
      const key = (form.querySelector('[name="access_key"]') as HTMLInputElement)
        ?.value;
      // If access key not configured yet, fall back to mailto.
      if (!key || key.startsWith('[')) {
        status.textContent =
          'Formulaire non encore configuré — écrivez-nous directement par e-mail.';
        status.className = 'form-status is-error';
        return;
      }
      status.textContent = 'Envoi en cours…';
      status.className = 'form-status';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          form.reset();
          status.textContent =
            'Merci ! Votre demande a bien été envoyée. Nous revenons vers vous rapidement.';
          status.className = 'form-status is-success';
        } else {
          throw new Error(data.message || 'Erreur');
        }
      } catch (err) {
        status.textContent =
          'Une erreur est survenue. Réessayez ou écrivez-nous directement par e-mail.';
        status.className = 'form-status is-error';
      }
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    background: var(--bg-pale-2);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--green-900);
  }
  label span {
    color: var(--text-soft);
    font-weight: 400;
  }
  input,
  textarea {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--text);
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--green-600);
    box-shadow: 0 0 0 3px rgba(35, 122, 83, 0.14);
  }
  textarea {
    resize: vertical;
  }
  .hp {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-status {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .form-status.is-success {
    color: var(--green-600);
    font-weight: 600;
  }
  .form-status.is-error {
    color: #b4442f;
    font-weight: 600;
  }

  .contact-info {
    background: var(--bg-pale);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .contact-info h2 {
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .contact-info ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .contact-info li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .contact-info__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #fff;
    color: var(--green-600);
    box-shadow: var(--shadow-sm);
  }
  .contact-info__label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
    margin-bottom: 0.15rem;
  }
  .contact-info__note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-soft);
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
