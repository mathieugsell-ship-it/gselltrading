---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Stat from '../components/Stat.astro';
import Faq from '../components/Faq.astro';
import ReportCard from '../components/ReportCard.astro';
import CtaSection from '../components/CtaSection.astro';
import HeroArt from '../components/HeroArt.astro';
import WithWithout from '../components/WithWithout.astro';
import InteractiveMap from '../components/InteractiveMap.astro';
import Testimonials from '../components/Testimonials.astro';
import { REPORTS, SHOW_TESTIMONIALS } from '../data/site';

const heroBullets = [
  'Spécialistes agro-alimentaire',
  'Sur le terrain à Phuket',
  'Commission transparente',
];

const valueBadges = [
  { icon: 'scale', label: 'Sans stock' },
  { icon: 'wallet', label: 'Commission transparente' },
  { icon: 'languages', label: 'Bilingue FR / EN' },
  { icon: 'map-pin', label: 'Présence terrain à Phuket' },
];

const services = [
  { icon: 'search', title: 'Sourcing & sélection', text: 'Identifier des fournisseurs fiables, adaptés à votre cahier des charges.' },
  { icon: 'shield-check', title: 'Vérification & anti-fraude', text: 'Contrôler l’existence, la fiabilité et la conformité avant tout engagement.' },
  { icon: 'handshake', title: 'Négociation', text: 'Défendre vos intérêts sur le prix, les volumes et les conditions de paiement.' },
  { icon: 'badge-check', title: 'Qualité & conformité', text: 'Coordonner inspections, certifications et documents d’export.' },
  { icon: 'truck', title: 'Logistique & suivi', text: 'Accompagner l’expédition, de l’empotage au conteneur livré.' },
];

const process = [
  { title: 'Cadrage', text: 'On clarifie votre besoin, vos volumes et vos contraintes.' },
  { title: 'Sourcing', text: 'On identifie et présélectionne des fournisseurs pertinents.' },
  { title: 'Vérification', text: 'On sécurise : existence, fiabilité, conformité, échantillons.' },
  { title: 'Négociation & contrat', text: 'On obtient les meilleures conditions et on cadre l’accord.' },
  { title: 'Exécution & suivi', text: 'On accompagne qualité, documents et expédition jusqu’au bout.' },
];

const differentiators = [
  { icon: 'sprout', title: 'Spécialistes de l’agro-alimentaire', text: 'Pas des généralistes : nous connaissons le riz, le thon et les filières agro thaïes.' },
  { icon: 'map-pin', title: 'Sur le terrain, à Phuket', text: 'Une présence locale réelle, pas un intermédiaire à distance.' },
  { icon: 'wallet', title: 'Commission transparente', text: 'Nous sommes payés par vous, pour défendre vos intérêts — jamais de marge cachée côté fournisseur.' },
  { icon: 'scale', title: 'Sans stock, sans conflit d’intérêt', text: 'Nous ne vous vendons pas notre marchandise : nous trouvons la vôtre.' },
  { icon: 'languages', title: 'Bilingues FR / EN', text: 'Un interlocuteur unique, dans votre langue, entre vous et le marché thaï.' },
];

const risks = [
  { icon: 'circle-alert', label: 'Sociétés fictives' },
  { icon: 'file-text', label: 'Faux documents d’expédition' },
  { icon: 'wallet', label: 'Virements détournés' },
  { icon: 'badge-check', label: 'Qualité qui se dégrade' },
];

const faq = [
  { q: 'Faut-il une société en Thaïlande pour importer ?', a: 'Non : vous achetez depuis votre pays. C’est l’exportateur thaï qui doit être agréé — nous nous assurons que c’est bien le cas et que la chaîne documentaire est en règle.' },
  { q: 'Comment êtes-vous rémunérés ?', a: 'À la commission, transparente et convenue à l’avance. Nous ne prenons pas de marge cachée côté fournisseur.' },
  { q: 'Travaillez-vous avec de petits volumes ?', a: 'Oui, y compris pour un premier conteneur d’essai. Nous accompagnons aussi les primo-importateurs.' },
  { q: 'Quels produits couvrez-vous ?', a: 'L’agro-alimentaire thaï : riz, thon en conserve, produits halal et agro-transformés.' },
  { q: 'Où êtes-vous basés ?', a: 'En Thaïlande, à Phuket, avec un accès direct au terrain.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const title = 'Gselltrading — Sourcing agro-alimentaire en Thaïlande';
const description =
  'Courtier agro-alimentaire sur le terrain en Thaïlande. Nous accompagnons les importateurs étrangers : sourcing, vérification, négociation et suivi, sans stock et à commission transparente.';
---

<BaseLayout title={title} description={description} path="/" jsonLd={[faqJsonLd]}>
  <!-- ============ 3.3 HERO ============ -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <h1>Importer des produits agro-alimentaires thaïlandais, en toute confiance.</h1>
        <p class="hero__subtitle">
          Basés en Thaïlande, nous accompagnons les sociétés étrangères qui
          souhaitent sourcer du riz, du thon en conserve et des produits
          agro-alimentaires thaïs — de la sélection du fournisseur au conteneur
          expédié. Sans stock, à commission transparente.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary btn--lg" href="/contact">
            Discuter de votre projet
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--ghost btn--lg" href="/rapports">Consulter nos rapports</a>
        </div>
        <ul class="hero__bullets">
          {heroBullets.map((b) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {b}
            </li>
          ))}
        </ul>
      </div>
      <div class="hero__art">
        <HeroArt />
      </div>
    </div>

    <div class="hero__statsband">
      <div class="container hero__stats">
        <Stat value={339} suffix=" Md$" label="exportations thaïlandaises en 2025" light />
        <Stat display="1ᵉʳ" label="exportateur mondial de thon en conserve" light />
        <Stat value={7.9} decimals={1} suffix=" M t" label="de riz exporté par la Thaïlande en 2025" light />
        <Stat value={100} suffix=" %" label="de nos honoraires transparents" light />
      </div>
    </div>
  </section>

  <!-- ============ 3.4 PROBLÈME + BADGES VALEUR ============ -->
  <section class="section">
    <div class="container section__head reveal">
      <span class="eyebrow">Le constat</span>
      <h2>Sourcer en Thaïlande peut coûter cher quand on s’y prend seul.</h2>
      <p class="lead">
        Fournisseurs difficiles à vérifier, barrière de la langue, licences
        d’export, contrôle qualité, termes de paiement risqués : chaque maillon
        mal maîtrisé pèse sur la marge — ou expose à la fraude. Notre métier est
        de sécuriser cette chaîne pour vous, sur le terrain.
      </p>
    </div>
    <div class="container">
      <ul class="value-badges reveal">
        {valueBadges.map((v) => (
          <li>
            <span class="value-badges__icon"><Icon name={v.icon} size={20} /></span>
            {v.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 3.5 AVEC OU SANS ============ -->
  <section class="section section--pale">
    <div class="container">
      <div class="section__head center-head reveal">
        <span class="eyebrow">La différence</span>
        <h2>Avec ou sans nous ? Voyez la différence.</h2>
        <p class="lead" style="margin-inline:auto">
          Le même projet d’import, vécu de deux façons très différentes.
        </p>
      </div>
      <div class="reveal">
        <WithWithout />
      </div>
    </div>
  </section>

  <!-- ============ 3.6 SERVICES ============ -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Nos services</span>
        <h2>Un accompagnement de bout en bout</h2>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a class="card card--hover reveal" href="/services">
            <span class="card__icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </a>
        ))}
      </div>
      <p class="reveal" style="margin-top:1.75rem">
        <a class="arrow-link" href="/services">
          Découvrir tous nos services
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    </div>
  </section>

  <!-- ============ 3.7 CARTE INTERACTIVE ★ ============ -->
  <section class="section section--pale-2">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Sur le terrain</span>
        <h2>Nous sommes là où ça se produit.</h2>
        <p class="lead">
          De la rizière du Nord-Est aux conserveries du Golfe, jusqu’aux marchés
          d’import à l’autre bout du monde : explorez les filières agro thaïes et
          les corridors d’export.
        </p>
      </div>
      <div class="reveal">
        <InteractiveMap />
      </div>
    </div>
  </section>

  <!-- ============ 3.8 MÉTHODE / TIMELINE ============ -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Notre méthode</span>
        <h2>Comment nous travaillons</h2>
      </div>
      <ol class="timeline">
        {process.map((step, i) => (
          <li class="timeline__item reveal">
            <span class="timeline__num">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 3.9 CHIFFRES MARCHÉ ============ -->
  <section class="section market">
    <div class="container">
      <div class="section__head center-head reveal">
        <span class="eyebrow eyebrow--light">Le marché en chiffres</span>
        <h2>Une filière agro parmi les plus puissantes au monde</h2>
      </div>
      <div class="market__stats">
        <Stat value={339} suffix=" Md$" label="d’exportations thaïlandaises en 2025" light />
        <Stat value={7.9} decimals={1} suffix=" M t" label="de riz exporté en 2025" light />
        <Stat display="1ᵉʳ" label="exportateur mondial de thon en conserve" light />
        <Stat value={549} suffix=" k t" label="de thon en conserve exportées (2024)" light />
      </div>
      <p class="market__source reveal">
        D’où viennent ces chiffres ?
        <a href="/rapports">Nos rapports de marché →</a>
      </p>
    </div>
  </section>

  <!-- ============ 3.10 POURQUOI NOUS ============ -->
  <section class="section section--pale">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Nos différences</span>
        <h2>Ce qui nous distingue</h2>
      </div>
      <div class="grid grid--3">
        {differentiators.map((d) => (
          <div class="card reveal">
            <span class="card__icon"><Icon name={d.icon} /></span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 3.11 CONFIANCE / ANTI-FRAUDE ============ -->
  <section class="section">
    <div class="container trust__inner reveal">
      <div class="trust__lead">
        <div class="trust__icon" aria-hidden="true"><Icon name="shield-check" size={40} /></div>
        <span class="eyebrow">Confiance & protection</span>
        <h2>Acheter à distance, sans les mauvaises surprises</h2>
        <p>
          Les arnaques au sourcing existent : sociétés fictives, faux documents
          d’expédition, virements détournés, qualité qui se dégrade entre
          l’échantillon et le conteneur. Notre rôle est d’interposer une
          vérification rigoureuse et une présence physique entre vous et ces
          risques. Nous privilégions toujours des conditions de paiement
          protectrices et un contrôle qualité avant expédition.
        </p>
      </div>
      <ul class="risks">
        {risks.map((r) => (
          <li class="risks__item">
            <span class="risks__icon"><Icon name={r.icon} size={20} /></span>
            <span class="risks__label">{r.label}</span>
            <span class="risks__tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              Neutralisé
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 3.12 RAPPORTS ============ -->
  <section class="section section--pale-2">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Notre lecture du marché</span>
        <h2>Nos rapports</h2>
        <p class="lead">
          Nous publions des analyses sectorielles pour partager notre lecture des
          filières agro-alimentaires thaïes — chiffres à l’appui.
        </p>
      </div>
      <div class="grid grid--3">
        {REPORTS.map((r) => (
          <div class="reveal">
            <ReportCard slug={r.slug} title={r.shortTitle} summary={r.summary} icon={r.icon} />
          </div>
        ))}
      </div>
      <p class="reveal" style="margin-top:1.75rem">
        <a class="arrow-link" href="/rapports">
          Voir tous les rapports
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    </div>
  </section>

  <!-- ============ 3.13 TÉMOIGNAGES (gated) ============ -->
  {SHOW_TESTIMONIALS && (
    <section class="section">
      <div class="container">
        <div class="section__head center-head reveal">
          <span class="eyebrow">Références</span>
          <h2>Ils nous font confiance</h2>
        </div>
        <div class="reveal">
          <Testimonials />
        </div>
      </div>
    </section>
  )}

  <!-- ============ 3.14 FAQ ============ -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Questions fréquentes</h2>
      </div>
      <div class="reveal">
        <Faq items={faq} idPrefix="home-faq" />
      </div>
    </div>
  </section>

  <!-- ============ 3.15 CTA FINAL ============ -->
  <CtaSection
    title="Parlons de votre projet d’import."
    text="Décrivez-nous votre besoin — nous vous répondons rapidement."
    buttonLabel="Nous contacter"
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, #0b2e22 0%, var(--green-900) 38%, var(--green-700) 78%, var(--green-600) 100%);
  }
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 82% 12%, rgba(127, 217, 168, 0.26), transparent 42%),
      radial-gradient(circle at 12% 90%, rgba(127, 217, 168, 0.12), transparent 45%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 4vw, 3.5rem);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
  }
  .hero__subtitle {
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    color: rgba(255, 255, 255, 0.88);
    max-width: 42rem;
    margin-bottom: 1.75rem;
  }
  .hero__cta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .hero__bullets {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .hero__bullets li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__bullets svg {
    color: var(--mint);
  }
  .hero__art {
    display: flex;
    justify-content: center;
  }
  .hero__statsband {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(0, 0, 0, 0.12);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1.25rem 1rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__art {
      order: -1;
      max-width: 380px;
      margin-inline: auto;
    }
  }

  /* ---------- Value badges ---------- */
  .value-badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .value-badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-pale);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    font-weight: 700;
    color: var(--green-900);
    font-size: 0.95rem;
  }
  .value-badges__icon {
    display: inline-flex;
    color: var(--green-600);
  }

  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    position: relative;
  }
  .timeline__item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    position: relative;
  }
  .timeline__num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--green-900);
    color: var(--mint);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .timeline__item h3 {
    margin-bottom: 0.25rem;
  }
  .timeline__item p {
    margin: 0;
    color: var(--text-soft);
  }
  @media (min-width: 760px) {
    .timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
    .timeline__item {
      flex-direction: column;
    }
    .timeline::before {
      content: '';
      position: absolute;
      top: 23px;
      left: 8%;
      right: 8%;
      height: 2px;
      background: linear-gradient(to right, var(--mint), var(--green-600));
      z-index: 0;
    }
    .timeline__num {
      position: relative;
      z-index: 1;
    }
  }

  /* ---------- Market ---------- */
  .market {
    background: linear-gradient(135deg, var(--green-900), var(--green-700));
    color: #fff;
  }
  .market h2 {
    color: #fff;
  }
  .eyebrow--light {
    color: var(--mint);
  }
  .market__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 1rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .market__source {
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }
  .market__source a {
    color: var(--mint);
    font-weight: 700;
  }

  /* ---------- Trust / anti-fraude ---------- */
  .trust__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--bg-pale);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .trust__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 18px;
    background: #fff;
    color: var(--green-600);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1rem;
  }
  .trust__lead h2 {
    margin-bottom: 0.75rem;
  }
  .trust__lead p {
    color: var(--text);
    margin: 0;
  }
  .risks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .risks__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
  }
  .risks__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: #fdf5f3;
    color: #c0553c;
    flex-shrink: 0;
  }
  .risks__label {
    font-weight: 600;
    color: var(--green-900);
    flex: 1;
  }
  .risks__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--green-600);
    font-weight: 700;
    font-size: 0.82rem;
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    .trust__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
