---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../data/site';

const title =
  'Services de sourcing agro-alimentaire en Thaïlande | Gselltrading';
const description =
  'Sourcing, vérification anti-fraude, négociation, contrôle qualité et suivi logistique pour importer des produits agro-alimentaires thaïlandais. Accompagnement sur le terrain, à commission transparente.';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Sourcing et import de produits agro-alimentaires thaïlandais',
  provider: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  areaServed: { '@type': 'Country', name: 'Thaïlande' },
  audience: {
    '@type': 'Audience',
    audienceType: 'Importateurs et sociétés étrangères',
  },
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Accompagnement à l’import agro-alimentaire',
    itemListElement: [
      'Sourcing & sélection de fournisseurs',
      'Vérification & prévention de la fraude',
      'Négociation',
      'Qualité, certifications & documents d’export',
      'Logistique & suivi d’expédition',
    ].map((name) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name },
    })),
  },
};

const blocks = [
  {
    icon: 'search',
    title: 'Sourcing & sélection de fournisseurs',
    text: 'Nous identifions des fournisseurs adaptés à votre cahier des charges (produit, qualité, volume, budget, marché de destination) et présélectionnons les options les plus pertinentes. Vous gardez la décision ; nous vous apportons le terrain et le tri.',
  },
  {
    icon: 'shield-check',
    title: 'Vérification & prévention de la fraude',
    text: 'Avant tout engagement, nous vérifions l’existence réelle, la fiabilité et la conformité d’un fournisseur. Sociétés fictives, faux documents, qualité qui se dégrade : nous interposons un contrôle rigoureux et une présence physique entre vous et ces risques.',
  },
  {
    icon: 'handshake',
    title: 'Négociation',
    text: 'Nous négocions pour vous le prix, les volumes et surtout les conditions de paiement. Objectif : des termes justes et protecteurs, adossés à notre connaissance des prix de marché.',
  },
  {
    icon: 'badge-check',
    title: 'Qualité, certifications & documents d’export',
    text: 'Nous coordonnons les inspections qualité et les documents nécessaires à votre import (origine, conformité, certifications sectorielles comme le halal quand c’est pertinent). Vous recevez une marchandise conforme à ce qui a été convenu.',
  },
  {
    icon: 'truck',
    title: 'Logistique & suivi d’expédition',
    text: 'De la supervision de l’empotage au conteneur expédié, nous accompagnons la logistique et gardons un œil sur chaque étape jusqu’à la livraison.',
  },
];

const model = [
  {
    title: 'Sans stock',
    text: 'Nous ne vous vendons pas notre marchandise, nous trouvons la vôtre — donc aucun conflit d’intérêt.',
  },
  {
    title: 'Commission transparente',
    text: 'Notre rémunération est convenue à l’avance et connue de vous. Jamais de marge dissimulée côté fournisseur.',
  },
  {
    title: 'Un interlocuteur unique',
    text: 'Une seule personne vous suit, en français ou en anglais, du premier échange à la livraison.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/services"
  jsonLd={[serviceJsonLd]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>Nos services d’accompagnement à l’import agro-alimentaire</h1>
      <p class="lead">
        Nous accompagnons les sociétés étrangères qui veulent sourcer des
        produits agro-alimentaires thaïlandais, à chaque étape de la chaîne.
        Notre rôle : sécuriser vos achats, défendre vos intérêts et vous faire
        gagner du temps — sans jamais détenir de stock ni prendre de marge
        cachée.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container services-list">
      {
        blocks.map((b, i) => (
          <article class="service-row reveal">
            <div class="service-row__icon">
              <Icon name={b.icon} size={28} />
            </div>
            <div class="service-row__body">
              <h2>{b.title}</h2>
              <p>{b.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--pale">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Notre modèle</span>
        <h2>Un modèle simple et transparent</h2>
      </div>
      <div class="grid grid--3">
        {
          model.map((m) => (
            <div class="card reveal">
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section__head reveal">
      <span class="eyebrow">Périmètre</span>
      <h2>Les filières que nous couvrons</h2>
      <p class="lead">
        Riz (dont Hom Mali et riz blanc), thon en conserve, produits halal et
        agro-transformés thaïlandais. Pour aller plus loin sur ces marchés,
        consultez <a href="/rapports">nos rapports</a>.
      </p>
    </div>
  </section>

  <CtaSection
    title="Un projet d’import en tête ?"
    text="Présentez-nous votre besoin, nous vous répondons rapidement."
    buttonLabel="Discuter de votre projet"
  />
</BaseLayout>

<style>
  .page-hero {
    background: var(--bg-pale-2);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }
  .page-hero h1 {
    max-width: 20ch;
  }
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .service-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .service-row:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--mint);
  }
  .service-row__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: var(--bg-pale);
    color: var(--green-600);
  }
  .service-row__body h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    margin-bottom: 0.5rem;
  }
  .service-row__body p {
    margin: 0;
    color: var(--text);
  }
  @media (max-width: 560px) {
    .service-row {
      flex-direction: column;
      gap: 1rem;
      padding: 1.4rem;
    }
  }
</style>
